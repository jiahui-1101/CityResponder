APP_NAME=CityResponder Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8010
DATABASE_URL=sqlite:///./data/cityresponder.db
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
JWT_SECRET_KEY=development-only-change-this-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEV_SEED_PASSWORD=CityResponderDev123!
DEV_OPERATOR_EMAIL=operator@example.com
DEV_FIREFIGHTER_EMAIL=firefighter@example.com
DEV_RISK_PLANNER_EMAIL=risk-planner@example.com
DEV_ADMIN_EMAIL=admin@example.com
VISION_SOURCE=0
VISION_CAMERA_INDEX=0
VISION_FRAME_WIDTH=1280
VISION_FRAME_HEIGHT=720
VISION_DETECTION_MODEL=yolov8n.pt
VISION_SEGMENTATION_MODEL=yolov8n-seg.pt
VISION_BUILDING_ROI_MIN_WIDTH_PX=280
VISION_BUILDING_ROI_MIN_HEIGHT_PX=180
VISION_MIN_ROAD_WIDTH_PX=120
# Optional explicit conversion in centimetres per pixel; leave empty until calibrated.
# VISION_PIXEL_TO_CM_SCALE=
SENSOR_MQ2_STALE_AFTER_SECONDS=2.0
SENSOR_DHT22_STALE_AFTER_SECONDS=3.0
VISION_STALE_AFTER_SECONDS=1.0
VISION_DETECTION_TARGET_FPS=5.0
VISION_SEGMENTATION_TARGET_FPS=2.0
# TBD: provide ROI coordinates when the tabletop geometry is defined.
# JSON object format: {"x":0,"y":0,"width":280,"height":180}
# VISION_BUILDING_ROI_COORDINATES=
# JSON array format for road regions: [{"name":"road_1","x":0,"y":0,"width":120,"height":180}]
# VISION_ROAD_ROI_COORDINATES=
# JSON array format for hazard zones: [{"name":"hazard_zone_1","x":0,"y":0,"width":120,"height":120}]
# VISION_HAZARD_ROI_COORDINATES=
# Optional JSON mapping, for example: {"road_1":"IR_A","road_2":"IR_B"}
# VISION_ROAD_IR_MAPPING=
# TBD: configure only after the occupancy/IR disagreement semantics are defined.
# VISION_IR_CONFLICT_OCCUPANCY_THRESHOLD=
# VISION_IR_CONFLICT_VALUE_THRESHOLD=
# TBD: proposal does not define confidence thresholds.
# VISION_DETECTION_CONFIDENCE_THRESHOLD=
# VISION_SEGMENTATION_CONFIDENCE_THRESHOLD=
