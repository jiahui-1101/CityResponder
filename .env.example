APP_NAME=CityResponder Backend
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8020
# Keep this allowlist exact; never use wildcard CORS with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://city-responder.vercel.app
# Runtime configuration is loaded from %LOCALAPPDATA%\CityResponder\config\.env
# on Windows (override with CITYRESPONDER_CONFIG_FILE). Runtime database and
# evidence defaults live under %LOCALAPPDATA%\CityResponder\data, outside the
# project and any OneDrive-synced workspace. Set DATABASE_URL only when needed.
# DATABASE_URL=sqlite:///path/to/cityresponder.db
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Set a unique random value of at least 32 characters in each runtime environment.
JWT_SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Local development only. Production never creates accounts from this value.
DEV_SEED_PASSWORD=replace-with-local-development-password
DEV_OPERATOR_EMAIL=operator@example.com
DEV_FIREFIGHTER_EMAIL=firefighter@example.com
DEV_RISK_PLANNER_EMAIL=risk-planner@example.com
DEV_ADMIN_EMAIL=admin@example.com
VISION_SOURCE=CAMERA
# Set the camera device index in the local backend/.env for the target machine.
# VISION_CAMERA_INDEX=0
# Optional explicit Windows camera mode; keep unset in shared defaults.
# VISION_CAMERA_BACKEND=DSHOW
# VISION_CAMERA_FOURCC=MJPG
VISION_FRAME_WIDTH=1920
VISION_FRAME_HEIGHT=1080
VISION_LIVE_ENABLED=false
VISION_PREVIEW_ENABLED=false
VISION_AI_DISPLAY_ENABLED=false
# Keep evidence publishing disabled until the active ROI/model output is approved.
VISION_PUBLISH_EVIDENCE_ENABLED=false
DETECTION_WEIGHTS=runs/detect/runs/cityresponder_detection_v2/train/weights/best.pt
SEGMENTATION_WEIGHTS=runs/segment/runs/cityresponder_segmentation_v1/train2/weights/best.pt
VISION_INFERENCE_SIZE=640
VISION_INFERENCE_CPU_THREADS=2
VISION_INFERENCE_DEVICE=auto
# Observation-only dashboard cadence; does not change production inference policy.
VISION_AI_DISPLAY_TARGET_FPS=4.0
VISION_AI_OVERLAY_VALID_SECONDS=1.5
VISION_REQUIRE_EXACT_FRAME_SIZE=true
# Display-only normalized crop. Production decision and ROI coordinates are unaffected.
VISION_DISPLAY_CROP_LEFT=0.0
VISION_DISPLAY_CROP_TOP=0.0
VISION_DISPLAY_CROP_RIGHT=1.0
VISION_DISPLAY_CROP_BOTTOM=1.0
VISION_BOARD_CROP_COORDINATES={"name":"raw_board_crop","x":340,"y":80,"width":1080,"height":840}
VISION_BUILDING_ROI_MIN_WIDTH_PX=280
VISION_BUILDING_ROI_MIN_HEIGHT_PX=180
VISION_MIN_ROAD_WIDTH_PX=120
# Optional explicit conversion in centimetres per pixel; leave empty until calibrated.
# VISION_PIXEL_TO_CM_SCALE=
SENSOR_MQ2_STALE_AFTER_SECONDS=2.0
SENSOR_DHT22_STALE_AFTER_SECONDS=3.0
SENSOR_DIGITAL_STALE_AFTER_SECONDS=2.0
# Exact registered sensor node IDs. Add demo IDs only in isolated test configs.
SENSOR_ALLOWED_NODE_IDS=SN1
SENSOR_MQTT_TOPIC_PREFIX=city/sensors
VISION_STALE_AFTER_SECONDS=1.0
VISION_DETECTION_TARGET_FPS=5.0
VISION_SEGMENTATION_TARGET_FPS=2.0
# Locked ROIs use RAW_BOARD_CROP coordinates, not RAW_CAMERA coordinates.
VISION_BUILDING_ROI_COORDINATES={"name":"building_a","x":460,"y":350,"width":340,"height":360}
VISION_ROAD_ROI_COORDINATES=[{"name":"road_main","x":10,"y":675,"width":1035,"height":145}]
# JSON array format for hazard zones: [{"name":"hazard_zone_1","x":0,"y":0,"width":120,"height":120}]
# VISION_HAZARD_ROI_COORDINATES=
# Optional JSON mapping, for example: {"road_1":"IR_A","road_2":"IR_B"}
# VISION_ROAD_IR_MAPPING=
# TBD: configure only after the occupancy/IR disagreement semantics are defined.
# VISION_IR_CONFLICT_OCCUPANCY_THRESHOLD=
# VISION_IR_CONFLICT_VALUE_THRESHOLD=
# TBD: proposal does not define confidence thresholds.
# VISION_DETECTION_CONFIDENCE_THRESHOLD=
# VISION_SEGMENTATION_CONFIDENCE_THRESHOLD=
# Controlled local prototype storage for explicitly selected annotated incident frames.
# EVIDENCE_STORAGE_DIR defaults to the per-user CityResponder data directory.
# Implementation safety limit only; retention duration remains TBD_SOURCE.
EVIDENCE_MAX_FILE_SIZE_BYTES=10000000
# Keep only exact, operator-approved origins here. Add the allocated HTTPS
# origin to the external runtime config when a temporary demo tunnel is used.
WEBSOCKET_ALLOWED_ORIGINS=http://127.0.0.1:8080
